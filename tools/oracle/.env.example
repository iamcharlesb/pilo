# Copy outside the checkout; chmod 600. Never paste credentials into chat.
# OCI CLI credentials use its own ~/.oci/config, not this file or the VM.
PILO_OCI_PROFILE=DEFAULT
PILO_OCI_REGION=YOUR_REGION
PILO_OCI_INSTANCE_ID=YOUR_INSTANCE_OCID
PILO_OCI_SSH_HOST=YOUR_VM_IP
PILO_OCI_SSH_USER=ubuntu
PILO_OCI_SSH_IDENTITY=/absolute/path/to/your/ssh-key
PILO_OCI_SSH_PORT=22
# Same port locally/remotely preserves the server's Origin/Host checks.
PILO_OCI_APP_PORT=8766
PILO_OCI_ALLOWED_SHAPE=VM.Standard.A1.Flex
PILO_OCI_MAX_OCPUS=2
PILO_OCI_MAX_MEMORY_GB=12
